node_modules/
build/
dist/
*.tgz
.DS_Store

# .npmrc — ignore everywhere EXCEPT the repo root, where we ship a
# tracked security-defaults file (min-release-age, save-exact, etc.).
# Nested .npmrc files are still ignored so contributor auth tokens can't
# leak into a commit.
.npmrc
!/.npmrc

.env
.env.*
.factory/

# Secrets / credentials
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_rsa.*
*.token.json
credentials/
.cache/

# Live-probe capture artefacts may contain real account data — never commit
**/reports/live-probe-*.json

# Test coverage output
coverage/

# Nested git worktrees (improve/<connector>-* sessions) — never commit
.worktrees/
