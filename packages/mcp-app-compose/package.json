{
  "name": "@mindstone/mcp-app-compose",
  "version": "0.1.0",
  "description": "Build-time generator for the shared compose/send MCP-App iframe HTML used by email-shaped connectors",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
