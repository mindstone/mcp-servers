# Repo-level npm defaults — applied to every connector's install
# (npm walks parent dirs for .npmrc, so this catches every
# connectors/<name>/ install too).
#
# FOX-3319 supply-chain audit: post HN-thread review (item id 48100706).
# Manual-publish architecture: publishes happen from the wave-lead's dev
# machine (see docs/PUBLISH_APPROVAL_PROCESS.md). There is no CI publish
# workflow; the install-time defences below are the operative protection.

# Cool-down on freshly-published dependencies. With manual publishes we
# can no longer enforce this in a CI publish workflow, so set it at install
# time: every `npm ci` / `npm install` (and every PR-CI build that runs
# them) refuses to resolve a package version published less than 7 days
# ago. Requires npm >= 11.10. Failing-loud in PR CI on a < 7-day-old pin
# is the intended behaviour; the fix to a blocked PR is to wait the
# cool-down out or pin to the previous version.
min-release-age=7

# Always pin exact versions when contributors run `npm install <dep>`.
# Caret ranges (^x.y.z) are the primary mechanism by which a single
# malicious republish on npm can reach consumer installs that don't
# use `npm ci` strictly. (Our CI does use npm ci, but local-dev
# `npm install` would not respect the lockfile for new additions.)
save-exact=true
save-prefix=

# Provenance attestations on every publish. With manual publishes this
# is best-effort (publisher must remember --provenance on the command
# line; manual publishes can also legitimately set `--provenance=false`
# when not running under a Trusted Publisher context — see MIGRATION.md).
provenance=true

# Reproducibility / noise controls.
fund=false
audit=true
audit-level=high

# Do NOT set `ignore-scripts=true` globally — it would silently skip
# every connector's `prepare: npm run build` during contributor
# `npm install`, and contributors rely on that. CI passes `--ignore-scripts`
# explicitly on the `npm ci` line in .github/workflows/ci.yml and re-runs
# the build via the explicit `npm run build` step. Manual publishes run
# `npm ci --ignore-scripts && npm run build` per the runbook in
# docs/PUBLISH_APPROVAL_PROCESS.md.
