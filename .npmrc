# Repo-level npm defaults — applied to every connector's install
# (npm walks parent dirs for .npmrc, so this catches every
# connectors/<name>/ install too).
#
# FOX-3319 supply-chain audit: post HN-thread review (item id 48100706).
#
# NOTE: the cool-down setting `min-release-age` (the strongest single
# mitigation per the HN thread) is NOT set here. Applied repo-wide it
# would fail-loud in CI any time a connector's lockfile pins a
# < 7-day-old dependency — breaking every PR until the freshly-published
# dep aged out. Instead, the publish workflow sets
# `NPM_CONFIG_MIN_RELEASE_AGE=7` in the env block of its build step so
# the cool-down is enforced where it matters most (release time) without
# blocking ongoing PR CI. See .github/workflows/publish.yml. pnpm v11
# defaults to 1440 minutes (24h); we use 7 days at release time only.

# Always pin exact versions when contributors run `npm install <dep>`.
# Caret ranges (^x.y.z) are the primary mechanism by which a single
# malicious republish on npm can reach consumer installs that don't
# use `npm ci` strictly. (Our CI does use npm ci, but local-dev
# `npm install` would not respect the lockfile for new additions.)
save-exact=true
save-prefix=

# Provenance attestations on every publish (defence-in-depth — the
# publish workflow also passes --provenance and sets NPM_CONFIG_PROVENANCE
# in the env, so disabling here would still be overridden at runtime).
provenance=true

# Reproducibility / noise controls.
fund=false
audit=true
audit-level=high

# Do NOT set `ignore-scripts=true` globally — it would break
# `npm run build` (which spawns local-bin tsc, fine) but would also
# silently skip every connector's `prepare: npm run build` during
# contributor `npm install`. We rely on per-job `--ignore-scripts` in
# the publish workflow instead, where the security boundary actually
# matters. Contributors are documented to use `--ignore-scripts` when
# installing for code review.
