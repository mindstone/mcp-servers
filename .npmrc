# npm defaults for installs run from this folder (the repo root).
#
# npm reads a project .npmrc only beside the package it installs, not from
# parent folders, so these lines do not reach an install inside
# connectors/<name>/. Each connector is protected by its own lockfile,
# installed with `npm ci --ignore-scripts` in CI and in the release workflow.
#
# Publishing: .github/workflows/release.yml publishes each version bump from
# `npm run mcp:release` with Trusted Publishing and Sigstore provenance.
# The full set of supply-chain rules, and the check behind each, is in
# Rebel's docs/project/MCP_SUPPLY_CHAIN.md.

# Cool-down on freshly published dependencies when npm resolves new versions
# here (`npm install`). It never filters an existing lockfile, so it does not
# protect `npm ci`; Rebel's PR checks enforce the 7-day cool-down on lockfile
# changes instead (scripts/check-release-age.ts). Requires npm >= 11.10.
min-release-age=7

# Always pin exact versions when contributors run `npm install <dep>`.
# Caret ranges (^x.y.z) are the primary mechanism by which a single
# malicious republish on npm can reach consumer installs that don't
# use `npm ci` strictly.
save-exact=true
save-prefix=

# Provenance attestations on every publish (the release workflow also
# passes --provenance; a brand-new package's first, manual publish may not
# have it).
provenance=true

# Reproducibility / noise controls.
fund=false
audit=true
audit-level=high

# Do NOT set `ignore-scripts=true` globally — it would silently skip
# every connector's `prepare: npm run build` during contributor
# `npm install`, and contributors rely on that. CI passes `--ignore-scripts`
# explicitly on every `npm ci` line in .github/workflows/ (ci.yml and
# release.yml) and re-runs the build via an explicit `npm run build` step.
