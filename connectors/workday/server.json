{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mindstone/mcp-server-workday",
  "title": "Workday",
  "description": "Workday HCM MCP server for Model Context Protocol hosts \u2014 workers, profiles, organizations",
  "version": "0.2.2",
  "repository": {
    "url": "https://github.com/mindstone/mcp-servers",
    "source": "github",
    "subfolder": "connectors/workday"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mindstone/mcp-server-workday",
      "version": "0.2.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WORKDAY_HOST",
          "description": "Workday API host (e.g. wd5-impl-services1.workday.com)",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "WORKDAY_TENANT",
          "description": "Workday tenant ID",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "WORKDAY_CLIENT_ID",
          "description": "Workday OAuth 2.0 client ID",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "WORKDAY_CLIENT_SECRET",
          "description": "Workday OAuth 2.0 client secret",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "WORKDAY_REFRESH_TOKEN",
          "description": "Workday OAuth 2.0 refresh token",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.mindstone.rebel": {
        "catalogId": "bundled-workday",
        "provider": "rebel-oss"
      }
    }
  }
}
