{
  "name": "@mindstone/mcp-server-xero",
  "version": "0.0.17",
  "mcpName": "io.github.mindstone/mcp-server-xero",
  "description": "Xero MCP server for invoices, contacts, payments, quotes, and financial reports",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindstone/mcp-servers.git",
    "directory": "connectors/xero"
  },
  "homepage": "https://github.com/mindstone/mcp-servers/tree/main/connectors/xero",
  "author": "Xero (https://xero.com)",
  "type": "module",
  "bin": {
    "mcp-server-xero": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm audit --omit=dev --audit-level=high",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint --fix",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.17.0",
    "dotenv": "^16.4.7",
    "openid-client": "^6.8.1",
    "xero-node": "^13.3.0",
    "zod": "3.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.7.4",
    "shx": "^0.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.10.0"
}
