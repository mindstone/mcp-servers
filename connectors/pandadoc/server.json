{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mindstone/mcp-server-pandadoc",
  "title": "PandaDoc",
  "description": "PandaDoc document automation MCP server for Model Context Protocol hosts",
  "version": "0.2.1",
  "repository": {
    "url": "https://github.com/mindstone/mcp-servers",
    "source": "github",
    "subfolder": "connectors/pandadoc"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mindstone-engineering/mcp-server-pandadoc",
      "version": "0.2.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PANDADOC_API_KEY",
          "description": "PandaDoc API key (from Developer Dashboard)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MCP_WORKSPACE_PATH",
          "description": "Workspace directory for document upload sources. Defaults to os.tmpdir() when unset.",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.mindstone.rebel": {
        "catalogId": "bundled-pandadoc",
        "provider": "rebel-oss"
      }
    }
  }
}
