{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mindstone/mcp-server-browser-automation",
  "title": "Browser Automation",
  "description": "Browser automation MCP server: navigate, fill forms, click, screenshot, and manage tabs",
  "version": "0.1.6",
  "repository": {
    "url": "https://github.com/mindstone/mcp-servers",
    "source": "github",
    "subfolder": "connectors/browser-automation"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mindstone-engineering/mcp-server-browser-automation",
      "version": "0.1.6",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AGENT_BROWSER_SESSION_NAME",
          "description": "Session name for browser persistence",
          "isRequired": false,
          "default": "mcp",
          "format": "string"
        },
        {
          "name": "AGENT_BROWSER_SHOW_WINDOW",
          "description": "Set to 'false' to run the browser headless. Default is visible (true).",
          "isRequired": false,
          "default": "true",
          "format": "string"
        },
        {
          "name": "BROWSER_AUTOMATION_ALLOW_EVAL",
          "description": "Set to 1 to register the browser_evaluate tool (off by default for security)",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.mindstone.rebel": {
        "catalogId": "bundled-browser-automation",
        "provider": "rebel-oss"
      }
    }
  }
}
