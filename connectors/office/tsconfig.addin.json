{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["office-js"]
  },
  "include": [
    "src/addin/**/*.ts",
    "src/shared/office/**/*.ts",
    "src/shared/appBridge/**/*.ts",
    "src/shared/intentClient/**/*.ts",
    "src/shared/chatController/**/*.ts",
    "src/shared/chatUI/**/*.ts"
  ]
}
