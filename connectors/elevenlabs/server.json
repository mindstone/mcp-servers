{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mindstone/mcp-server-elevenlabs",
  "title": "ElevenLabs",
  "description": "ElevenLabs MCP server: TTS, music, sound effects, voices, and audio transcription",
  "version": "0.2.1",
  "repository": {
    "url": "https://github.com/mindstone/mcp-servers",
    "source": "github",
    "subfolder": "connectors/elevenlabs"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mindstone-engineering/mcp-server-elevenlabs",
      "version": "0.2.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ELEVENLABS_API_KEY",
          "description": "ElevenLabs API key (starts with sk_)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MCP_WORKSPACE_PATH",
          "description": "Workspace directory for transcription audio file inputs. Defaults to os.tmpdir() when unset.",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.mindstone.rebel": {
        "catalogId": "bundled-elevenlabs",
        "provider": "rebel-oss"
      }
    }
  }
}
