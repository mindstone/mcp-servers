{
  "name": "@mindstone/mcp-server-replit-ssh",
  "version": "0.2.1",
  "mcpName": "io.github.mindstone/mcp-server-replit-ssh",
  "description": "Replit SSH MCP server — read, write, list, and check files on Replit projects over SSH/SFTP, plus generate the local SSH key and config.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-replit-ssh": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mindstone/mcp-servers.git",
    "directory": "connectors/replit-ssh"
  },
  "homepage": "https://github.com/mindstone/mcp-servers/tree/main/connectors/replit-ssh",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ssh-config": "^5.1.0",
    "ssh2": "^1.17.0",
    "sshpk": "^1.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@mindstone/mcp-test-harness": "file:../../test-harness",
    "@types/node": "^22",
    "@types/ssh2": "^1.15.5",
    "@types/sshpk": "^1.17.4",
    "@vitest/coverage-v8": "^4.1.3",
    "msw": "^2.13.2",
    "shx": "^0.3.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "hono": "^4.12.18",
    "ip-address": "^10.2.0"
  }
}
