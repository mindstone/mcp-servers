{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mindstone/mcp-server-nano-banana",
  "title": "Nano Banana",
  "description": "Nano Banana MCP server — Google Gemini image generation and editing via Model Context Protocol",
  "version": "0.4.0",
  "repository": {
    "url": "https://github.com/mindstone/mcp-servers",
    "source": "github",
    "subfolder": "connectors/nano-banana"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mindstone/mcp-server-nano-banana",
      "version": "0.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GEMINI_API_KEY",
          "description": "Google Gemini API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MCP_WORKSPACE_PATH",
          "description": "Workspace directory for saving generated images",
          "isRequired": false,
          "format": "filepath"
        },
        {
          "name": "NANO_BANANA_GEMINI_TIMEOUT_MS",
          "description": "Outbound Gemini request timeout in milliseconds",
          "isRequired": false,
          "default": "180000",
          "format": "number"
        },
        {
          "name": "NANO_BANANA_BRIDGE_TIMEOUT_MS",
          "description": "Host-bridge request timeout in milliseconds",
          "isRequired": false,
          "default": "30000",
          "format": "number"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.mindstone.rebel": {
        "catalogId": "bundled-nano-banana",
        "provider": "rebel-oss"
      }
    }
  }
}
