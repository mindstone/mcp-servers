{
  "name": "@mindstone-engineering/mcp-server-email-imap",
  "version": "0.2.2",
  "mcpName": "io.github.mindstone/mcp-server-email-imap",
  "description": "Email IMAP/SMTP MCP server for Model Context Protocol hosts — supports iCloud Mail, Yahoo Mail, and custom IMAP providers",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "bin": {
    "mcp-server-email-imap": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mindstone/mcp-servers.git",
    "directory": "connectors/email-imap"
  },
  "homepage": "https://github.com/mindstone/mcp-servers/tree/main/connectors/email-imap",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "imapflow": "^1.2.0",
    "nodemailer": "^8.0.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@mindstone-engineering/mcp-test-harness": "file:../../test-harness",
    "@types/node": "^22",
    "@types/nodemailer": "^6.4.0",
    "@vitest/coverage-v8": "^4.1.3",
    "msw": "^2.13.2",
    "shx": "^0.3.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
