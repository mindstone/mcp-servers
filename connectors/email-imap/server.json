{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mindstone/mcp-server-email-imap",
  "title": "Email (IMAP/SMTP)",
  "description": "Email IMAP/SMTP MCP server: iCloud, Gmail, Yahoo, Outlook, and custom IMAP providers",
  "version": "0.3.4",
  "repository": {
    "url": "https://github.com/mindstone/mcp-servers",
    "source": "github",
    "subfolder": "connectors/email-imap"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mindstone/mcp-server-email-imap",
      "version": "0.3.4",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EMAIL_IMAP_EMAIL",
          "description": "Email address",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "EMAIL_IMAP_PASSWORD",
          "description": "App-specific password",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "EMAIL_IMAP_PROVIDER",
          "description": "Provider — icloud, gmail, yahoo, outlook, or custom (auto-detected from email domain if unset)",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "EMAIL_IMAP_IMAP_HOST",
          "description": "Custom IMAP host (for provider=custom)",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "EMAIL_IMAP_SMTP_HOST",
          "description": "Custom SMTP host (for provider=custom)",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "EMAIL_IMAP_IMAP_PORT",
          "description": "Custom IMAP port",
          "isRequired": false,
          "default": "993",
          "format": "number"
        },
        {
          "name": "EMAIL_IMAP_SMTP_PORT",
          "description": "Custom SMTP port",
          "isRequired": false,
          "default": "587",
          "format": "number"
        },
        {
          "name": "MCP_WORKSPACE_PATH",
          "description": "Workspace directory that email_get_attachment downloads into (fresh email-imap-attachment-* staging directories). Defaults to the system temp directory.",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.mindstone.rebel": {
        "catalogIds": [
          "bundled-custom-email",
          "bundled-icloud-mail",
          "bundled-yahoo-mail"
        ],
        "provider": "rebel-oss"
      }
    }
  }
}
