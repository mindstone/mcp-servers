{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mindstone/mcp-server-salesforce",
  "title": "Salesforce",
  "description": "Salesforce CRM MCP server: accounts, contacts, opportunities, leads, tasks, and custom objects",
  "version": "0.2.2",
  "repository": {
    "url": "https://github.com/mindstone/mcp-servers",
    "source": "github",
    "subfolder": "connectors/salesforce"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mindstone/mcp-server-salesforce",
      "version": "0.2.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SALESFORCE_CLIENT_ID",
          "description": "Salesforce Connected App client ID (recommended path)",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "SALESFORCE_CLIENT_SECRET",
          "description": "Salesforce Connected App client secret (recommended path)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "SALESFORCE_SANDBOX",
          "description": "Set to true for sandbox environments",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "SALESFORCE_ACCESS_TOKEN",
          "description": "Static access token (alternative to OAuth)",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "SALESFORCE_INSTANCE_URL",
          "description": "Salesforce instance URL (required for manual token mode)",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "SALESFORCE_CONFIG_DIR",
          "description": "Custom config directory",
          "isRequired": false,
          "default": "~/.mcp/salesforce",
          "format": "filepath"
        },
        {
          "name": "SALESFORCE_OAUTH_PORT",
          "description": "OAuth callback port (0 = OS-assigned)",
          "isRequired": false,
          "default": "0",
          "format": "number"
        },
        {
          "name": "SALESFORCE_OAUTH_SCOPES",
          "description": "Space-separated OAuth scopes",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.mindstone.rebel": {
        "catalogId": "bundled-salesforce",
        "provider": "rebel-oss"
      }
    }
  }
}
