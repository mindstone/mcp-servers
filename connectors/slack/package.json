{
  "name": "@mindstone/mcp-server-slack",
  "version": "0.2.0",
  "mcpName": "io.github.mindstone/mcp-server-slack",
  "description": "Slack workspace MCP server — channels, messages, threads, reactions, users, files, bookmarks, scheduling via Slack Web API",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "bin": {
    "mcp-server-slack": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mindstone/mcp-servers.git",
    "directory": "connectors/slack"
  },
  "homepage": "https://github.com/mindstone/mcp-servers/tree/main/connectors/slack",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc && shx chmod +x dist/index.js",
    "build": "npm run compile && bash scripts/check-no-bridge-strings.sh",
    "prepare": "npm run compile",
    "prepublishOnly": "npm run build && npm run test && bash scripts/check-no-bridge-strings.sh",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "compose:template": "node scripts/gen-compose-html.mjs",
    "compose:template:check": "node scripts/gen-compose-html.mjs --check",
    "pretest": "npm run compose:template:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "probe:live": "node --import tsx test/live-probe.ts",
    "probe:live:gate": "LIVE_PROBE_REQUIRE_WRITES=1 node --import tsx test/live-probe.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@slack/web-api": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@mindstone/mcp-app-compose": "file:../../packages/mcp-app-compose",
    "@mindstone/mcp-test-harness": "file:../../test-harness",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.3",
    "msw": "^2.13.2",
    "shx": "^0.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
