{
  "name": "@mindstone/mcp-server-openai-image",
  "version": "0.2.0",
  "mcpName": "io.github.mindstone/mcp-server-openai-image",
  "description": "OpenAI image generation MCP server for Model Context Protocol hosts",
  "author": "Mindstone <support@mindstone.ai>",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-openai-image": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mindstone/mcp-servers.git",
    "directory": "connectors/openai-image"
  },
  "bugs": {
    "url": "https://github.com/mindstone/mcp-servers/issues"
  },
  "homepage": "https://github.com/mindstone/mcp-servers/tree/main/connectors/openai-image",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc && shx chmod +x dist/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "dev": "npm run watch",
    "start": "node dist/index.js",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.3",
    "shx": "^0.3.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "hono": "^4.12.18",
    "ip-address": "^10.2.0"
  }
}
